# Copia este archivo como .env.local y rellena los valores.
# .env.local NUNCA se sube al repositorio.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para el script de carga de datos (scripts/ingest). NUNCA en el navegador ni en Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: asistente con IA. Si está vacío, el asistente usa recomendaciones por reglas.
ANTHROPIC_API_KEY=
# Opcional: modelo de Claude del asistente (por defecto claude-haiku-5-5; también vale un Sonnet, p. ej. claude-sonnet-5-5)
ANTHROPIC_MODEL=
